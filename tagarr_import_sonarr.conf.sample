# ========== CONFIGURATION ==========
# Config for tagarr_import_sonarr.sh — Release Group Recovery on Import
#
# This script runs as a Sonarr Connect handler (On Download).
# When an episode arrives with an empty or unknown release group, it looks
# up the grab history using the download ID and patches the episodefile
# with the correct release group from the grab event.
#
# This fixes the scoring loop where some trackers use different names for
# the torrent vs the file — Sonarr grabs based on the torrent name (with
# release group), but the file doesn't include it, causing Custom Format
# scores to drop and Sonarr to grab again.
#
# Notification behavior:
#   - Release group recovered → Discord embed (green) with series/episode info
#   - Already has group       → Silent (no notification)
#   - Cannot recover          → Silent (no notification)
#   - Test event              → Confirmation embed with version and status
#
# See README.md for setup instructions.

# Copy this file to tagarr_import_sonarr.conf and fill in your values.

# Copy this file to tagarr_import_sonarr.conf and fill in your values.

# === SONARR ===
# The Sonarr instance this script runs in (Connect > Custom Script).
# Use container hostname when running inside Docker, IP when running from host.
SONARR_URL="http://localhost:8989"
SONARR_API_KEY="your-api-key-here"
SONARR_NAME="Sonarr"

# === RENAME ===
# Triggers Sonarr's RenameFiles command after fixing each episode.
# Requires {Release Group} in your Sonarr episode naming format.
ENABLE_RENAME=true

# === RELEASE GROUP RECOVERY ===
# When enabled, episodes imported with an empty/unknown release group are
# recovered using the download ID from Sonarr's grab history. The correct
# group is patched into the episodefile and a rename is triggered.
#
# How it works: Sonarr provides a download ID on import that matches the
# original grab event. The script looks up the grab by this ID to find
# the release group — no guessing, no walking through old history.
ENABLE_RECOVER=true

# === DISCORD NOTIFICATIONS ===
# Send per-episode notifications when a release group is recovered.
# Silent when nothing happens (group already present, cannot recover).
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=""

# === LOGGING ===
# Main log file. Rotated automatically at 2 MiB (keeps one .old backup).
ENABLE_LOGGING=true
LOG_FILE="${SCRIPT_DIR}/logs/tagarr_import_sonarr.log"
