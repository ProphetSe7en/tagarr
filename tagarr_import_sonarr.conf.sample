# ========== CONFIGURATION ==========
# Config version: 1.1
# Config for tagarr_import_sonarr.sh — Release Group Recovery + Grab-Rename
#
# Runs as a Sonarr Connect handler. Wire up "On Grab" + "On Import" +
# "On Upgrade" events in Sonarr > Settings > Connect > Custom Script.
#
# Two recovery paths:
#   1. GRAB (qBit torrent rename, before download finishes) — adds release
#      group + user-defined tokens (e.g. AMZN, NF, DSNP) to the qBit
#      torrent name so they survive into Sonarr's import-time CF scoring.
#   2. IMPORT/UPGRADE (release group recovery via downloadId) — when an
#      episode imports with empty/unknown release group, looks up the
#      grab history and patches the episodefile.
#
# Notification behavior:
#   - Tokens recovered (Grab)    → Discord embed (orange) with details
#   - Release group recovered    → Discord embed (green) with series info
#   - Already has group / cosmetic → Silent (no notification)
#   - Test event                 → Confirmation embed
#
# See README.md for setup instructions.

# Copy this file to tagarr_import_sonarr.conf and fill in your values.

# Copy this file to tagarr_import_sonarr.conf and fill in your values.

# === SONARR ===
# The Sonarr instance this script runs in (Connect > Custom Script).
# Use container hostname when running inside Docker, IP when running from host.
SONARR_URL="http://localhost:8989"
SONARR_API_KEY="your-api-key-here"
SONARR_NAME="Sonarr"

# === RENAME ===
# Triggers Sonarr's RenameFiles command after fixing each episode.
# Requires {Release Group} in your Sonarr episode naming format.
ENABLE_RENAME=true

# === RELEASE GROUP RECOVERY ===
# When enabled, episodes imported with an empty/unknown release group are
# recovered using the download ID from Sonarr's grab history. The correct
# group is patched into the episodefile and a rename is triggered.
#
# How it works: Sonarr provides a download ID on import that matches the
# original grab event. The script looks up the grab by this ID to find
# the release group — no guessing, no walking through old history.
ENABLE_RECOVER=true

# === GRAB-RENAME (qBit torrent rename, runs on Sonarr Grab event) ===
# When enabled, the script renames the qBit torrent on grab so that
# tokens present in the indexer's release title — but missing from the
# qBit torrent name — make it into Sonarr's import-time CF scoring.
#
# Sonarr reads the qBit torrent display name (not the file on disk) for
# CF re-evaluation at import. So if your indexer titles include source
# flags like AMZN/NF/DSNP but the actual filename strips them, the
# matching CFs (e.g. TRaSH "AMZN" CF, +75) score zero on import — the
# release loops as Sonarr keeps re-grabbing the higher-scoring version.
#
# What gets recovered:
#   - Release group is automatic — if the qBit name lacks `-<RG>` it's
#     appended.
#   - Custom tokens are user-defined below in GRAB_RENAME_CUSTOM_TOKENS.
#     Default is empty — you only chase tokens you actually score.
#
# This is OFF by default. Enable only after configuring QBIT_CLIENTS.
ENABLE_GRAB_RENAME=false

# === QBIT_CLIENTS — required when ENABLE_GRAB_RENAME=true ===
# Maps the download client name from Sonarr to the qBit Web UI URL.
#
# 1. Open Sonarr > Settings > Download Clients > your qBit entry.
# 2. Find the "Name" field at the top (e.g. "qBittorrent" or "qBit-tv").
# 3. Use that exact name on the left side of the colon below.
# 4. Put the qBit Web UI URL (host:port) on the right.
#
# Single-client setup: even if the name doesn't match, the script falls
# back to the only entry. Multi-client setups MUST have names match.
#
# Qui proxy users: the URL format is
# http://qui:7476/proxy/<your-32-char-client-id>
QBIT_CLIENTS=(
    "qBittorrent:http://localhost:8080"
)

# === GRAB_RENAME_CUSTOM_TOKENS — user-defined recovery tokens ===
# Each entry is "Label:regex". The script triggers a rename if the regex
# matches in the indexer's release title but NOT in the qBit torrent
# name. Label is what appears in the Discord notification; regex is
# bash-extended (POSIX ERE — no lookahead/lookbehind).
#
# Common Sonarr use case: streaming-source flags. The TRaSH `[Streaming
# Services] General` CF group matches these from the release title — if
# the filename strips them, the CF score evaporates on import.
#
# About the examples below: the regex patterns are simplified versions
# of TRaSH's CF specifications. TRaSH uses Perl-compatible regex with
# lookahead/lookbehind constructs (e.g. "MAX but not preceded by HBO")
# that bash grep -E does not support. The simplifications below trade
# precision for compatibility — for streaming flags this is usually
# safe, since the script only renames when the token is in the indexer
# title but missing from the file name (so a too-broad regex causes
# false-negatives rather than wrong renames). Verify against your own
# scoring chain if you customize.
#
# Two pre-uncommented examples (AMZN and NF) — the most common in
# user reports of the scoring loop. Uncomment additional services
# below if your CF set rewards them.
GRAB_RENAME_CUSTOM_TOKENS=(
    "AMZN:\\b(amzn|amazon(hd)?)\\b"
    "NF:\\b(nf|netflix(u?hd)?)\\b"

    # Other streaming services from TRaSH's [Streaming Services] General
    # group. Uncomment the ones your CFs use:
    # "ATV:\\b(atv|appletv)\\b"
    # "ATVP:\\b(atvp|aptv|Apple TV\\+)\\b"
    # "CC:\\bcc\\b"
    # "DCU:\\b(dcu|DC Universe)\\b"
    # "DSNP:\\b(dsnp|dsny|disney|Disney\\+)\\b"
    # "HBO:\\bhbo\\b"
    # "HMAX:\\b(hmax|hbom|hbo[ ._-]?max)\\b"
    # "HULU:\\bhulu\\b"
    # "iT:\\b(it|itunes)\\b"
    # "PCOK:\\b(pcok|Peacock TV)\\b"
    # "PMTP:\\b(pmtp|Paramount\\+)\\b"
    # "ROKU:\\broku\\b"
    # "SHO:\\b(sho|showtime)\\b"
    # "STAN:\\bstan\\b"
    # "SYFY:\\bsyfy\\b"

    # MAX and PLAY are intentionally omitted — too generic on their own
    # without lookbehind/lookahead support. Add a stricter variant if
    # needed, e.g. "MAX:\\bmax[ ._-]web[ ._-]?(dl|rip)\\b"
)

# === DISCORD NOTIFICATIONS ===
# Send per-episode notifications when a release group is recovered.
# Silent when nothing happens (group already present, cannot recover).
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=""

# === LOGGING ===
# Main log file. Rotated automatically at 2 MiB (keeps one .old backup).
ENABLE_LOGGING=true
LOG_FILE="${SCRIPT_DIR}/logs/tagarr_import_sonarr.log"
