# ========== CONFIGURATION ==========
# Config for tagarr_import_sonarr.sh — Release Group Recovery on Import
#
# Sonarr Connect handler that recovers missing release groups when
# episodes are imported. Recovery only — no tagging or discovery.
#
# For detailed explanations of every option, see docs/tagarr-import-guide.md
#
# Setup: Sonarr > Settings > Connect > Custom Script
#   Path: /scripts/tagarr_import_sonarr.sh
#   Events: On Download (covers both new downloads and upgrades)
#
# This script fixes the scoring loop where some trackers use different
# names for the torrent vs the file — Sonarr grabs based on the torrent
# name (with release group), but the file doesn't include it, causing
# Custom Format scores to drop and Sonarr to grab again.

# Copy this file to tagarr_import_sonarr.conf and fill in your values.

# === SONARR ===
# The Sonarr instance this script runs in (Connect > Custom Script).
# URL: if running inside the Sonarr container, use http://localhost:8989.
#      If running on the host or another container, use the appropriate address.
# API key: found in Sonarr > Settings > General > API Key.
# Name: display label for logs and Discord (can be anything).
SONARR_URL="http://localhost:8989"
SONARR_API_KEY="your-api-key-here"
SONARR_NAME="Sonarr"

# === RENAME ===
# After recovering a release group, trigger Sonarr's RenameFiles command
# so the episode filename on disk includes the recovered group.
# Only has an effect if your Sonarr episode naming format includes
# {Release Group}. Set to false if you don't want file renames — e.g.,
# to preserve cross-seed hardlinks or existing file references.
ENABLE_RENAME=true

# === RELEASE GROUP RECOVERY ===
# Core feature of this script. When an episode is imported with an empty
# or "Unknown" release group, looks up the grab event using the download
# ID from the Sonarr Connect event and patches the correct group onto the
# episode file. This is the primary reason this script exists — to break
# the scoring loop caused by missing release groups.
# Set to false to effectively disable the script (it will do nothing).
ENABLE_RECOVER=true

# === DISCORD NOTIFICATIONS ===
# Sends a notification when a release group is successfully recovered.
# Silent when the episode already has a group or when recovery fails/isn't
# needed. Includes series poster thumbnail and episode number.
# Create a webhook: Server Settings > Integrations > Webhooks > New Webhook.
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=""

# === LOGGING ===
# Log file for all output (timestamped). Since the script runs automatically
# in the background, logging is the primary way to verify it's working.
# Rotated at 2 MiB (keeps one .old backup).
ENABLE_LOGGING=true
LOG_FILE="${SCRIPT_DIR}/logs/tagarr_import_sonarr.log"
